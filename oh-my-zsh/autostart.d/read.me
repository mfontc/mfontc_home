#!/usr/bin/env zsh
# vim: ft=zsh ts=2 sw=2 sts=2 noexpandtab

scriptAbsPath="$( cd "${0%/*}" &>/dev/null && echo "${PWD}/${0##*/}" )"
scriptBasePath=$( dirname "${scriptAbsPath}" )

cat <<README-ME

cat > "${scriptBasePath}/keychain.sh" <<KEYCHAIN-SH
# vim: ft=zsh ts=2 sw=2 sts=2 noexpandtab
mfontcKeysLoadq
KEYCHAIN-SH
chmod u+x "${scriptBasePath}/keychain.sh"

cat > "${scriptBasePath}/default_user.sh" <<DEFAULT_USER-SH
# vim: ft=zsh ts=2 sw=2 sts=2 noexpandtab
DEFAULT_USER=\\\${USER}
DEFAULT_USER-SH
chmod u+x "${scriptBasePath}/default_user.sh"

README-ME

