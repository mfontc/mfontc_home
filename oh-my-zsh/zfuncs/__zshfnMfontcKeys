# vim: ft=zsh ts=2 sw=2 sts=2 noexpandtab

function __mfontcKeysInstallKeychain() {
  echoIn "\nUpdating packets list…"; sudo apt-get -qq update       || return 1
  echoIn "\nInstalling keychain…";   sudo apt-get install keychain || return 1
}

function mfontcKeysLoad() {
  which keychain &> /dev/null || { __mfontcKeysInstallKeychain || return 1; }
  eval `keychain         --agents ssh --ignore-missing --eval ~/.ssh/*_rsa(.N) ~/.ssh/*_dsa(.N)`
}

function mfontcKeysLoadq() {
  which keychain &> /dev/null || { __mfontcKeysInstallKeychain || return 1; }
  eval `keychain --quiet --agents ssh --ignore-missing --eval ~/.ssh/*_rsa(.N) ~/.ssh/*_dsa(.N)`
}

function mfontcKeysShow() {
  ssh-add -l
}

function mfontcKeysClear() {
  which keychain &> /dev/null || { __mfontcKeysInstallKeychain || return 1; }
  keychain --clear
}

function mfontcKeysKill() {
  which keychain &> /dev/null || { __mfontcKeysInstallKeychain || return 1; }
  # -k all / -k mine
  keychain --stop all
}

function mfontcKeysHelp() {
  cat <<USAGE
Requirements:
  - keychain:         sudo apt-get install keychain

Functions available:
  - mfontcKeysLoad:   Load all your keys onto the agent
  - mfontcKeysLoadq:  Load all your keys onto the agent, quietly
  - mfontcKeysShow:   Show the loaded keys
  - mfontcKeysClear:  Unload the keys from the agent
  - mfontcKeysKill:   Unload the keys from the agent and kill currently running agent processes
  - mfontcKeysHelp:   This message

How to disable the "GNOME Keyring SSH Agent":
  Edit the gnome-keyring-ssh.desktop file and change the NoDisplay:
  - sudo vim /etc/xdg/autostart/gnome-keyring-ssh.desktop
    NoDisplay=false
  At that point, "SSH Key Agent - GNOME Keyring: SSH Agent" appeared in the
  Startup Applications manager, and you could uncheck it. Then, restart the session.

Location and name of keys:
  The scripts will find and use, by default, the keys that meet:
  - ~/.ssh/*_rsa
  - ~/.ssh/*_dsa

More info:
  - https://github.com/funtoo/keychain
  - http://www.gilluminate.com/2013/04/04/ubuntu-ssh-agent-and-you/

USAGE
}
